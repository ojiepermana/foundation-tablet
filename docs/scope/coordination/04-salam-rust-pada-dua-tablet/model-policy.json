    "spec_cross_check_same_model": {"source": "leader", "effort": "high", "explicit_selection": true, "read_only": true},
    "verify_helper": {"source": "routine", "source_for_high": "engineering", "effort": "medium", "explicit_selection": true},
    "review": {"source": "contrast", "effort": "high", "explicit_selection": true},
    "debug_investigation": {"source": "engineering", "effort": "high", "explicit_selection": true},
    "leader_owned_helper": {"selection_policy": "task_complexity", "effort": "per_task", "verified_inheritance_permitted": true}
  },
