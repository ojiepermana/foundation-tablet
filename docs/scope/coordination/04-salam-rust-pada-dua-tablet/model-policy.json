    {"agent_id": "develop-agent", "workflow_skill": "develop", "placement": "inline", "recommended_effort": "high"},
    {"agent_id": "verify-agent", "workflow_skill": "check verify", "placement": "native_worker", "delegation_scope": "permitted_helper", "preferred_model_source": "routine", "requested_effort": "medium"},
    {"agent_id": "test-agent", "workflow_skill": "test", "placement": "inline", "recommended_effort": "medium"},
    {"agent_id": "review-agent", "workflow_skill": "check review", "placement": "native_worker", "preferred_model_source": "contrast", "requested_effort": "high"},
    {"agent_id": "document-agent", "workflow_skill": "document", "placement": "inline", "recommended_effort": "low"},
    {"agent_id": "sync-agent", "workflow_skill": "sync", "placement": "inline", "recommended_effort": "low"},
    {"agent_id": "debug-agent", "workflow_skill": "debug", "placement": "native_worker", "delegation_scope": "permitted_investigation", "preferred_model_source": "engineering", "requested_effort": "high"}
